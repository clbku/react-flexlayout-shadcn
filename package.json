{
  "name": "react-flexlayout-shadcn",
  "version": "0.1.0",
  "description": "A multi-tab docking layout manager for React, ported from flexlayout-react and themed with shadcn/ui design tokens",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clbku/react-flexlayout-shadcn.git"
  },
  "homepage": "https://github.com/clbku/react-flexlayout-shadcn#readme",
  "bugs": {
    "url": "https://github.com/clbku/react-flexlayout-shadcn/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "layout",
    "flexlayout",
    "docking",
    "tabs",
    "shadcn",
    "tailwind"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "prepack": "npm run build",
    "build:demo": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
